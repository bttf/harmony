# Local Compose run only. On Railway these are service variables (deploy/README.md).
HARMONY_REVISION=local
HARMONY_CODE_URL=https://github.com/bttf/harmony
# Providers: Bandcamp, Deezer and iTunes need no credentials. Spotify is deferred.
# HARMONY_SPOTIFY_CLIENT_ID=
# HARMONY_SPOTIFY_CLIENT_SECRET=

# Shared secret for POST /api/waxnerd/lookup, called by apps/import (Authorization: Bearer <secret>).
# Same value as HARMONY_WAXNERD_SECRET in the import app's env. Generate with: openssl rand -hex 32
# Unset = the endpoint answers 401 to every request.
# HARMONY_WAXNERD_SECRET=
